# Copy to `.env` (gitignored) and fill in your own values.
# When the Cloudflare Worker proxy is live, set USE_PROXY=true + PROXY_BASE_URL and
# the client no longer needs the credentials below.

USE_PROXY=false
PROXY_BASE_URL=https://your-proxy.example.workers.dev

# Mappls InTouch OAuth client_credentials.
# Do NOT commit real values. Keep them only in your local .env (gitignored).
MAPPLS_CLIENT_ID=your_client_id_here
MAPPLS_CLIENT_SECRET=your_client_secret_here
